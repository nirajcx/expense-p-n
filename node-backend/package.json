{
  "name": "expense-node-backend",
  "version": "1.0.0",
  "description": "Expense tracker learning backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nodemon",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --env-file-if-exists=.env --test",
    "test:integration": "RUN_DB_TESTS=1 node --env-file-if-exists=.env --test tests/expense.integration.test.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.8"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14"
  }
}
